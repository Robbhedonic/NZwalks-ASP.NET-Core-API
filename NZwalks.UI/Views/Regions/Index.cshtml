@model List<NZwalks.UI.Models.RegionDto>

<h1 class="mt-3">Regions</h1>

<div class="mt-3">
    <a asp-controller="Regions" asp-action="Add" class="btn btn-primary">Add Region</a>
</div>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Name</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var region in Model)
        {
            <tr>
                <td>@region.Id</td>
                <td>@region.Code</td>
                <td>@region.Name</td>
                <td>@region.ImageUrl</td>
            </tr>
        }
    </tbody>
</table>
